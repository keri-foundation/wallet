diff --git a/setup.py b/setup.py
new file mode 100644
index 0000000..0ad95de
--- /dev/null
+++ b/setup.py
@@ -0,0 +1,24 @@
+from setuptools import setup
+from setuptools.dist import Distribution
+from wheel.bdist_wheel import bdist_wheel
+
+
+class BinaryDistribution(Distribution):
+    """Install the Python package in the wheel's platform root."""
+
+    def has_ext_modules(self):
+        return True
+
+
+class PyEmscriptenWheel(bdist_wheel):
+    """Mark the bundled libsodium side module as platform-specific."""
+
+    def finalize_options(self):
+        super().finalize_options()
+        self.root_is_pure = False
+
+    def get_tag(self):
+        return "py3", "none", "pyemscripten_2026_0_wasm32"
+
+
+setup(cmdclass={"bdist_wheel": PyEmscriptenWheel}, distclass=BinaryDistribution)
